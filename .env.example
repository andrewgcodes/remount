# Copy to .env and fill in only what you need. .env is git-ignored.
# Load it into the SERVER process only (set -a; . ./.env; set +a); bindings
# refer to these by name ("secret": "$OPENAI_API_KEY") and the workspace
# only ever sees a placeholder.

# Model providers used through the broker (examples and live lanes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Production modes: base64 of 32 random bytes for encrypted tenant artifacts
# REMOUNT_MASTER_KEY=

# Optional provider-backed node pools; leave unset to skip those lanes
# E2B_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_ENVIRONMENT=
# IX_TOKEN=

# Optional self-hosted OpenTelemetry collector for control-plane traces
# REMOUNT_OTLP_ENDPOINT=http://127.0.0.1:4318
