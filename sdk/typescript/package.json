{
  "name": "@remount/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Remount",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --emitDeclarationOnly --outDir dist --rootDir src && esbuild src/index.ts --bundle --packages=external --platform=neutral --target=es2022 --format=esm --outfile=dist/index.js && esbuild src/index.ts --bundle --packages=external --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "cbor-x": "^1.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "directories": {
    "test": "test"
  },
  "keywords": [
    "agents",
    "sandbox",
    "workspace",
    "runtime",
    "remount"
  ],
  "author": "Andrew Gao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewgcodes/remount.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/andrewgcodes/remount",
  "bugs": {
    "url": "https://github.com/andrewgcodes/remount/issues"
  }
}
