# Secrets — never commit
.env
.env.*
!.env.example
bindings.json
bindings.*.json

# Local state
#
# Anchored to the repository root on purpose. Unanchored, `remount-node/`
# matched deploy/helm/remount-node/ as well, so the Helm chart was invisible to
# git and would have been silently left out of a commit. These patterns exist
# for the directories `remount standalone` and `remount up` create here.
/remount-data/
/remount-node/
/remount
dist/

# Go
*.test
*.out
coverage.txt

# Python tooling
__pycache__/
*.py[cod]

# JavaScript tooling
node_modules/

# stray local builds of cmd/ programs
/agentloop
/evidence

# per-agent git worktrees created by coding assistants
/.claude/worktrees/

# OpenTofu / Terraform working directories
.terraform/
.vercel
